<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Softened, darkened wallpaper that fades in behind the app grid. -->
    <ImageView
        android:id="@+id/grid_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="@color/dock"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/net_status"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/net_bars"
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_marginBottom="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_signal" />

                <TextView
                    android:id="@+id/net_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/bt_icon"
                    android:layout_width="9dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/bt_status"
                    android:src="@drawable/ic_bluetooth"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/temp_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/dock_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <ImageButton
                android:id="@+id/dock_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/round_ripple"
                android:contentDescription="@string/dock_add"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:visibility="gone" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dock_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/round_ripple"
                android:contentDescription="@string/dock_toggle"
                android:scaleType="center"
                android:src="@drawable/ic_apps" />
        </LinearLayout>

        <com.nithin.nightdrive.ExactFrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/edit_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/sheet_bg"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/editing_home"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/edit_swap"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/swap_sides" />

                <TextView
                    android:id="@+id/edit_done"
                    style="@style/Segment"
                    android:layout_marginEnd="0dp"
                    android:text="@string/done" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="9dp"
                android:orientation="horizontal" />
        </com.nithin.nightdrive.ExactFrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/theme_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="33dp"
                android:paddingEnd="33dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/themes"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/theme_edit_home"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/edit_home" />

                <TextView
                    android:id="@+id/theme_done"
                    style="@style/Segment"
                    android:layout_marginEnd="0dp"
                    android:text="@string/done" />
            </LinearLayout>

            <TextView
                style="@style/PickerLabel"
                android:layout_marginTop="16dp"
                android:text="@string/appearance" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="33dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/appearance_auto"
                    style="@style/Segment"
                    android:text="@string/appearance_auto" />

                <TextView
                    android:id="@+id/appearance_light"
                    style="@style/Segment"
                    android:text="@string/appearance_light" />

                <TextView
                    android:id="@+id/appearance_dark"
                    style="@style/Segment"
                    android:text="@string/appearance_dark" />
            </LinearLayout>

            <TextView
                style="@style/PickerLabel"
                android:layout_marginTop="20dp"
                android:text="@string/options" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="33dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/option_corners"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/option_corners" />

                <TextView
                    android:id="@+id/option_sweep"
                    style="@style/Segment"
                    android:layout_width="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/option_sweep" />
            </LinearLayout>

            <TextView
                style="@style/PickerLabel"
                android:layout_marginTop="20dp"
                android:text="@string/wallpaper" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/theme_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/sheet_bg"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/sheet_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <com.nithin.nightdrive.CornerMask
        android:id="@+id/corner_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
