<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_media"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card"
    android:foreground="@drawable/app_cell_bg">

    <!-- A heavily blurred copy of the album art, so the card takes on its colours. -->
    <ImageView
        android:id="@+id/media_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/media_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/media_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp">

                <ImageView
                    android:id="@+id/media_art"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/art_bg"
                    android:contentDescription="@string/media_art"
                    android:scaleType="center"
                    android:src="@drawable/ic_music" />

                <ImageView
                    android:id="@+id/media_source"
                    android:layout_width="@dimen/media_badge"
                    android:layout_height="@dimen/media_badge"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/media_source"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/media_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/media_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <SeekBar
            android:id="@+id/media_seek"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:progressDrawable="@drawable/seek_track"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp">

            <TextView
                android:id="@+id/media_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/media_remaining"
                android:layout_width="64dp"
                android:gravity="end"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/media_previous"
                style="@style/MediaButton"
                android:contentDescription="@string/media_previous"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/media_play"
                style="@style/MediaButton"
                android:contentDescription="@string/media_play_pause"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/media_next"
                style="@style/MediaButton"
                android:contentDescription="@string/media_next"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
