<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_date"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:background="@drawable/date_tile_bg"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:format12Hour="EEE"
            android:format24Hour="EEE"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_light"
            android:format12Hour="d"
            android:format24Hour="d"
            android:includeFontPadding="false"
            android:textColor="#FF1C1C1E"
            android:textSize="42sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextClock
            android:id="@+id/date_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="d MMMM yyyy"
            android:format24Hour="d MMMM yyyy"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
