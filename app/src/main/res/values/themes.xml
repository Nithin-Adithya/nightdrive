<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nightdrive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="DockApp">
        <item name="android:layout_width">@dimen/dock_icon</item>
        <item name="android:layout_height">@dimen/dock_icon</item>
        <item name="android:background">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Segment">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/segment_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PickerLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">33dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="MediaButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/round_ripple</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
</resources>
