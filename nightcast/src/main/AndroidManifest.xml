<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Lets the mDNS queries iPhones use to discover AirPlay receivers through the Wi-Fi driver. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, granted by the user: lets the picture open by itself when mirroring starts. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The fallback when that is not granted: a notification that can take the idle screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Everything here runs in the ":cast" process, apart from the launcher that includes this
         library: a crash in the native protocol code then cannot take the home screen down. -->
    <application>

        <activity
            android:name=".MirrorActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:icon="@mipmap/cast_ic_launcher"
            android:label="@string/cast_name"
            android:launchMode="singleTask"
            android:process=":cast"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="com.nithin.nightcast"
            android:theme="@style/Theme.Nightcast">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ReceiverService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:process=":cast" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:process=":cast">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
