<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Always present, so the decoder has somewhere to draw the moment mirroring starts. -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="64dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cast_ic_cast" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cast_idle_title"
            android:textColor="@color/cast_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/cast_text_primary"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxWidth="640dp"
            android:textColor="@color/cast_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/cast_text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pin_toggle"
                style="@style/CastPill" />

            <TextView
                android:id="@+id/forget"
                style="@style/CastPill"
                android:text="@string/cast_forget" />

            <TextView
                android:id="@+id/auto_open"
                style="@style/CastPill"
                android:text="@string/cast_auto_open" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pin_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_pin_title"
            android:textColor="@color/cast_text_secondary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/cast_text_primary"
            android:textSize="96sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cast_pin_hint"
            android:textColor="@color/cast_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cast_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/art"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@drawable/cast_art_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cast_accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/cast_text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/cast_text_secondary"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/previous"
                    style="@style/CastTransport"
                    android:contentDescription="@string/cast_previous"
                    android:src="@drawable/cast_ic_previous" />

                <ImageButton
                    android:id="@+id/play_pause"
                    style="@style/CastTransport"
                    android:contentDescription="@string/cast_play_pause"
                    android:src="@drawable/cast_ic_pause" />

                <ImageButton
                    android:id="@+id/next"
                    style="@style/CastTransport"
                    android:contentDescription="@string/cast_next"
                    android:src="@drawable/cast_ic_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
